# ── Sesión / cookies ─────────────────────────────────────────────
# Clave para firmar la cookie de sesión. Genera una nueva en el VPS:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="cambia-esto-por-una-clave-larga-y-aleatoria"

# ── Usuarios admin (hasta 3) ─────────────────────────────────────
# Formato: usuario:contraseña  — separados por coma.
ADMIN_USERS="op1:vibra2026,op2:vibra2026,admin:recargo2026"

# ── Bajie Charging ───────────────────────────────────────────────
# Basic auth = base64 de "usuario:password".
# NO pongas aquí la real: va SOLO en el .env de producción (cópiala del .env
# del app de recargo que ya está en el server). Este es un placeholder.
BAJIE_CHARGING_BASIC_AUTH_KEY="REEMPLAZAR_por_base64_de_usuario:password"
BAJIE_BASE_URL="https://developer.chargenow.top/cdb-open-api/v1"
# Poner en 1 para usar el mock local sin hardware (desarrollo):
BAJIE_MOCK="0"

# ── App ──────────────────────────────────────────────────────────
DB_PATH="vibra.db"
TZ_NAME="America/Lima"
# Carpeta destino de los backups horarios (usada por scripts/backup.sh):
BACKUP_DIR="backups"
